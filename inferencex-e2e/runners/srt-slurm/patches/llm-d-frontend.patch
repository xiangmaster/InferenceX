+# vLLM aggregated behind the Shepherd Model Gateway (SMG).
+#
+# Two TP1 `vllm serve` workers on one node; SMG receives them through
+# `--worker-urls`, detects the engine from each worker, and routes with its
+# cache-aware policy. No Dynamo, NATS, or etcd. SMG runs from its own image
+# (`frontend.container_image`), so the model container needs no router package.
+#
+# Aliases (`qwen3-0.6b`, `vllm`, `smg`) resolve through srtslurm.yaml; see examples/README.md.
+
+schema: 2
+name: "qwen3-0.6b-vllm-smg-agg"
+
+slurm:
+  time_limit: "00:30:00"
+
+model:
+  path: "qwen3-0.6b"
+  container: "vllm"
+  precision: "bf16"
+
+resources:
+  gpu_type: "h100"
+  gpus_per_node: 8
+frontend:
+  type: smg
+  container_image: smg
+  enable_multiple_frontends: false
+  args:
+    policy: "cache_aware"
+
+engine: vllm
+roles:
+  agg:
+    nodes: 1
+    workers: 2
+    gpus: 1
+    env:
+      PYTHONUNBUFFERED: "1"
+    args:
+      served-model-name: "Qwen/Qwen3-0.6B"
+      tensor-parallel-size: 1
+      gpu-memory-utilization: 0.5
+      max-model-len: 4096
+
+benchmark:
+  type: "sa-bench"
+  isl: 128
+  osl: 128
+  concurrencies: "4x8"
