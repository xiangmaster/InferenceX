@@ -0,0 +1,49 @@
+# vLLM data parallel 16 with expert parallelism across two nodes, behind the
+# Shepherd Model Gateway (SMG).
+#
+# One `vllm serve` spans both nodes: node 0 serves the API and balances requests
+# over all 16 DP ranks itself, node 1 runs headless engine ranks. SMG therefore
+# receives a single worker URL. SMG's --dp-aware rank pinning discovers dp_size
+# from SGLang HTTP or gRPC workers only, not from vLLM HTTP workers (docs/smg.md).
+#
+# Aliases (`vllm`, `smg`) resolve through srtslurm.yaml; see examples/README.md.
+
+schema: 2
+name: "qwen3-30b-a3b-vllm-smg-dep16"
+
+slurm:
+  time_limit: "00:30:00"
+
+model:
+  path: "hf:Qwen/Qwen3-30B-A3B"
+  container: "vllm"
+  precision: "bf16"
+
+resources:
+  gpu_type: "h100"
+  gpus_per_node: 8
+frontend:
+  type: smg
+  container_image: smg
+  enable_multiple_frontends: false
+
+engine: vllm
+roles:
+  agg:
+    nodes: 2
+    workers: 1
+    gpus: 16
+    env:
+      PYTHONUNBUFFERED: "1"
+    args:
+      served-model-name: "Qwen/Qwen3-30B-A3B"
+      tensor-parallel-size: 1
+      data-parallel-size: 16
+      enable-expert-parallel: true
+      max-model-len: 4096
+
+benchmark:
+  type: "sa-bench"
+  isl: 128
+  osl: 128
+  concurrencies: "16x32"
